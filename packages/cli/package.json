{
  "name": "@kb/cli",
  "version": "0.1.0",
  "description": "Command-line interface to the kb knowledge-base orchestrator",
  "type": "module",
  "bin": { "kb": "./dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "openapi-typescript ../../openapi.json -o src/generated/api.d.ts",
    "test": "node --test --import tsx/esm --test-reporter=spec 'src/**/*.spec.ts'"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
