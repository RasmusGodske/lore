{
  "name": "@lore/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "openapi": "node dist/openapi.js > ../../openapi.json",
    "test": "node --test --disable-warning=ExperimentalWarning --import tsx --test-reporter=spec 'src/**/*.spec.ts' 'test/**/*.spec.ts'",
    "test:stack": "LORE_TEST_URL=${LORE_TEST_URL:-http://localhost:8480} LORE_TEST_ADMIN_TOKEN=${LORE_TEST_ADMIN_TOKEN:-$(cat ../../data/.token-dev)} LORE_TEST_DATA_DIR=${LORE_TEST_DATA_DIR:-$(cd ../.. && pwd)/data} npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.7",
    "dockerode": "^5.0.1",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
